{
  "mcpServers": {
    "playwright": {
      "command": "sh",
      "args": [
        "-c",
        "exec npx -y @playwright/mcp@0.0.83 --headless --isolated --output-dir .playwright-mcp --executable-path \"$CHROME_PATH\""
      ]
    },
    "svelte": {
      "command": "npx",
      "args": ["-y", "@sveltejs/mcp@0.1.31"]
    },
    "astro-docs": {
      "type": "http",
      "url": "https://mcp.docs.astro.build/mcp"
    }
  }
}
