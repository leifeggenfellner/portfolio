engine-strict=true
auto-install-peers=true
strict-peer-dependencies=false

# Supply-chain: reject packages published less than 3 days ago.
# Set to 0 to bypass entirely for initial lockfile generation.
minimum-release-age=3d

# pnpm 10+ requires explicit opt-in for postinstall scripts.
# These packages need their native build steps to run.
only-built[]=esbuild
only-built[]=sharp
