---
import notesIcon from "@/assets/icons/apps/pixel/about.svg?url";
import { getCollection } from "astro:content";
import { publishedPosts } from "@lib/feed";
import DocumentLayout from "@/layouts/DocumentLayout.astro";

const base = import.meta.env.BASE_URL;
const entries = await getCollection("posts");
const posts = publishedPosts(
  entries.map((entry) => ({ slug: entry.id, ...entry.data })),
  import.meta.env.DEV,
);
const dateFormat = new Intl.DateTimeFormat("en-GB", { dateStyle: "long", timeZone: "UTC" });
---

<DocumentLayout
  title="Writing"
  description="Notes on building RETRO//OS and other things."
  windowTitle={"C:\\Writing"}
  icon={notesIcon}
>
  <h1 class="font-chrome text-32 leading-none">Writing</h1>
  {
    posts.length === 0 ? (
      <p class="text-15 text-text-dim mt-4">
        Nothing published yet. The{" "}
        <a class="focus-ring text-link underline underline-offset-3" href={`${base}rss.xml`}>
          RSS feed
        </a>{" "}
        will have it first.
      </p>
    ) : (
      <ol class="mt-6 flex flex-col gap-4">
        {posts.map((post) => (
          <li>
            <h2 class="font-chrome text-18 leading-tight">
              <a class="focus-ring text-link underline underline-offset-3" href={`${base}posts/${post.slug}/`}>
                {post.title}
              </a>
              {post.draft && <span class="text-13 text-text-dim font-body"> (draft)</span>}
            </h2>
            <p class="text-16 text-text-dim mt-0.5 font-mono">
              <time datetime={post.date.toISOString().slice(0, 10)}>{dateFormat.format(post.date)}</time>
            </p>
            {post.description && <p class="text-14 mt-1 text-pretty">{post.description}</p>}
          </li>
        ))}
      </ol>
    )
  }
</DocumentLayout>
