---
/**
 * Every app's page: the desktop with that app's window open, server-rendered
 * with its real content (`/terminal/`, `/projects/retro-os/`, …). Generated
 * from the app manifests; adding an app adds its pages.
 */
import "@apps/server";
import { APPS } from "@apps/registry";
import { getEntry } from "astro:content";
import type { AppArgs, AppRoute } from "@lib/app-shell";
import { pageTitle } from "@lib/site";
import { personLd } from "@lib/structured-data";
import Os from "@shell/Os.svelte";
import RootLayout from "@/layouts/RootLayout.astro";

interface Props {
  appId: string;
  args?: AppArgs;
  title: string;
  description: string;
  image?: string;
  jsonLd?: AppRoute["jsonLd"];
}

export async function getStaticPaths() {
  const pages: { path: string; props: Props }[] = [];
  for (const app of APPS) {
    pages.push({ path: app.route, props: { appId: app.id, title: app.title, description: app.description } });
    for (const route of (await app.routes?.()) ?? []) {
      pages.push({
        path: route.path,
        props: { ...route, appId: app.id, description: route.description ?? app.description },
      });
    }
  }
  return pages.map(({ path, props }) => ({ params: { app: path.slice(1, -1) }, props }));
}

const { appId, args, title, description, image, jsonLd } = Astro.props;
const site = new URL(import.meta.env.BASE_URL, Astro.site);
const page = new URL(Astro.url.pathname, Astro.site);
const profile = (await getEntry("profile", "me"))!.data;
---

<RootLayout
  title={pageTitle(title)}
  description={description}
  image={image}
  jsonLd={[personLd(profile, site), ...(jsonLd ? [jsonLd(page, site)] : [])]}
>
  <Os client:desktop initial={{ appId, args }} />
</RootLayout>
