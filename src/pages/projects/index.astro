---
import folderIcon from "@/assets/icons/apps/pixel/projects.svg?url";
import { PROJECTS } from "@content/projects";
import DocumentLayout from "@/layouts/DocumentLayout.astro";

const base = import.meta.env.BASE_URL;
---

<DocumentLayout
  title="Projects"
  description="Case studies of the projects in the RETRO//OS explorer: what each one is, my role, and the stack."
  windowTitle={"C:\\Projects"}
  icon={folderIcon}
>
  <h1 class="font-chrome text-32 leading-none">Projects</h1>
  <p class="text-15 text-text-dim mt-2 max-w-[60ch]">The same projects as the desktop's explorer, one page each.</p>
  <ul class="mt-6 flex flex-col gap-3">
    {
      PROJECTS.map((project) => (
        <li class="border-bevel-shadow border px-4 py-3">
          <h2 class="font-chrome text-18 leading-tight">
            <a class="focus-ring text-link underline underline-offset-3" href={`${base}projects/${project.slug}/`}>
              {project.name}
            </a>
          </h2>
          <p class="text-14 mt-1 text-pretty">{project.tagline}</p>
          <p class="text-16 text-text-dim mt-1 font-mono">
            {project.year} · {project.role}
          </p>
        </li>
      ))
    }
  </ul>
</DocumentLayout>
