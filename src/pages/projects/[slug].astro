---
import diskIcon from "@/assets/icons/files/disk.svg?url";
import { getCollection } from "astro:content";
import DocumentLayout from "@/layouts/DocumentLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({ params: { slug: entry.data.slug }, props: { project: entry.data } }));
}

const { project } = Astro.props;
const LINK_BUTTON = "bevel-out focus-ring bg-surface text-14 inline-flex min-h-7 items-center px-4 font-semibold";
---

<DocumentLayout
  title={project.name}
  description={`${project.tagline} ${project.summary}`}
  image={project.cover}
  windowTitle={`${project.slug}.prj`}
  icon={diskIcon}
>
  <article>
    <header>
      <h1 class="font-chrome text-32 leading-none">{project.name}</h1>
      <p class="text-18 mt-2 font-semibold text-pretty">{project.tagline}</p>
    </header>

    {
      project.cover && (
        <img
          src={project.cover}
          alt={project.coverAlt ?? ""}
          width="1200"
          height="630"
          class="bevel-in mt-5 h-auto w-full"
          decoding="async"
        />
      )
    }

    <dl class="text-14 mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
      <dt class="font-semibold">Year</dt>
      <dd>{project.year}</dd>
      <dt class="font-semibold">Role</dt>
      <dd>{project.role}</dd>
    </dl>

    <p class="text-15 mt-5 max-w-[65ch] leading-relaxed text-pretty">{project.summary}</p>

    <h2 class="font-chrome text-18 border-bevel-shadow mt-6 border-b pb-1">Stack</h2>
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {project.tech.map((tech) => <li class="bevel-out-thin bg-surface text-13 px-2 py-0.5">{tech}</li>)}
    </ul>

    {
      (project.url || project.repo) && (
        <>
          <h2 class="font-chrome text-18 border-bevel-shadow mt-6 border-b pb-1">Links</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {project.url && (
              <a class={LINK_BUTTON} href={project.url} rel="noopener">
                Live site
              </a>
            )}
            {project.repo && (
              <a class={LINK_BUTTON} href={project.repo} rel="noopener">
                Source
              </a>
            )}
          </div>
        </>
      )
    }
  </article>
</DocumentLayout>
