---
/**
 * The plain version: the same bio, skills, projects and writing as the
 * desktop, as one ordinary page for readers who'd rather skip the OS.
 */
import aboutIcon from "@/assets/icons/apps/pixel/about.svg?url";
import About from "@apps/about/About.astro";
import SkillsMatrix from "@apps/skills/SkillsMatrix.astro";
import { PROFILE } from "@content/profile";
import { PROJECTS } from "@content/projects";
import DocumentLayout from "@/layouts/DocumentLayout.astro";

const base = import.meta.env.BASE_URL;
const LINK_CLASS = "focus-ring text-link underline underline-offset-3";
---

<DocumentLayout
  title={`${PROFILE.name}, plain`}
  description={`${PROFILE.name}: ${PROFILE.role}. The portfolio as one plain page: bio, experience, skills and projects.`}
  windowTitle="Me.txt"
  icon={aboutIcon}
>
  <About standalone />

  <section class="mt-8" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="font-chrome text-18 border-bevel-shadow border-b pb-1">Skills</h2>
    <div class="mt-3"><SkillsMatrix standalone /></div>
  </section>

  <section class="mt-8" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="font-chrome text-18 border-bevel-shadow border-b pb-1">Projects</h2>
    <ul class="text-14 mt-3 flex flex-col gap-2">
      {
        PROJECTS.map((project) => (
          <li>
            <a class={LINK_CLASS} href={`${base}projects/${project.slug}/`}>
              {project.name}
            </a>
            : {project.tagline}
          </li>
        ))
      }
    </ul>
  </section>

  <p class="text-14 text-text-dim mt-8">
    Prefer the full experience? <a class={LINK_CLASS} href={base}>Open the desktop</a>.
  </p>
</DocumentLayout>
