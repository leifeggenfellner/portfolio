---
/**
 * Home: the desktop with no window open. Server-rendered, so it works
 * without JavaScript (icons are links to each app's page); the island then
 * hydrates and the boot sequence may play over it.
 */
import { getEntry } from "astro:content";
import { SITE_TITLE } from "@lib/site";
import { personLd, websiteLd } from "@lib/structured-data";
import Os from "@shell/Os.svelte";
import RootLayout from "@/layouts/RootLayout.astro";

const site = new URL(import.meta.env.BASE_URL, Astro.site);
const profile = (await getEntry("profile", "me"))!.data;
---

<RootLayout bootable jsonLd={[personLd(profile, site), websiteLd(SITE_TITLE, site)]}>
  <Os client:desktop />
</RootLayout>
