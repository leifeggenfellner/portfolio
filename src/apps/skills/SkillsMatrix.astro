---
/**
 * Skills Matrix: no self-ratings. Each skill names where it can be seen, so
 * the claim can be checked. Rendered at build time from `@content/skills`.
 */
import { SKILL_GROUPS } from "@content/skills";

interface Props {
  /** On the plain page: part of the document flow, not a scrolling window body. */
  standalone?: boolean;
}

const { standalone = false } = Astro.props;
---

<!-- tabindex: the list can outgrow the window, and keyboard users need to scroll it. -->
<div
  class:list={["text-text flex flex-col gap-3", !standalone && "retro-scroll focus-ring h-full overflow-y-auto p-4"]}
  role={standalone ? undefined : "region"}
  aria-label={standalone ? undefined : "Skills"}
  tabindex={standalone ? undefined : 0}
>
  <p class="text-14 max-w-[60ch] text-pretty">No percentages here. Each skill points to where I have used it.</p>
  {
    SKILL_GROUPS.map((group) => (
      <table class="border-bevel-shadow text-14 w-full border">
        <caption class="text-13 bg-surface border-bevel-shadow border border-b-0 px-2 py-1 text-left font-semibold">
          {group.name}
        </caption>
        <thead class="sr-only">
          <tr>
            <th scope="col">Skill</th>
            <th scope="col">Where to see it</th>
          </tr>
        </thead>
        <tbody>
          {group.skills.map((skill) => (
            <tr class="border-bevel-shadow border-t first:border-t-0">
              <th scope="row" class="w-[45%] px-2 py-1.5 text-left align-top font-semibold">
                {skill.name}
              </th>
              <td class="text-text-dim px-2 py-1.5">{skill.evidence}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ))
  }
</div>
