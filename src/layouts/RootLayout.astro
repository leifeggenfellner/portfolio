---
/**
 * Root layout. Renders the desktop chrome around any page slot.
 * Loads global tokens + Tailwind once; sets HTML data attributes
 * for theme/CRT/accent that the entire token system reads from.
 *
 * Fonts are self-hosted and preloaded via Astro's built-in fonts
 * API (see astro.config.ts). Astro emits the @font-face rules and
 * the matching <link rel="preload"> tags automatically.
 */
import { Font } from "astro:assets";
import "@styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  theme?: "light" | "dark";
  crt?: "off" | "subtle" | "full";
  accent?: "default" | "magenta" | "cyan" | "amber";
  image?: string;
}

const {
  title = "Retro — a portfolio OS",
  description = "A retro-OS-inspired portfolio. Drag the windows.",
  theme = "light",
  crt = "full",
  accent = "default",
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en" data-theme={theme} data-crt={crt} data-accent={accent === "default" ? undefined : accent}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-chrome" preload />
    <Font cssVariable="--font-mono" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>
