---
/**
 * Root layout. Renders the desktop chrome around any page slot.
 * Loads global tokens + Tailwind once; sets HTML data attributes
 * for theme/CRT/accent that the entire token system reads from.
 *
 * Fonts are self-hosted and preloaded via Astro's built-in fonts
 * API (see astro.config.ts). Astro emits the @font-face rules and
 * the matching <link rel="preload"> tags automatically.
 */
import { Font } from "astro:assets";
import { DEFAULT_SETTINGS, rootAttributes, SETTINGS_BOOTSTRAP_SCRIPT } from "@lib/settings";
import "@styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** A scrolling document page rather than the full-viewport desktop. */
  document?: boolean;
  /** The desktop at `/`, where the boot sequence may play. */
  bootable?: boolean;
}

const {
  title = "Leif Eggenfellner — RETRO//OS",
  description = "Full-stack developer in Tromsø. This portfolio is a working retro desktop: a real terminal, a file explorer, Minesweeper and a synthwave horizon.",
  image,
  document = false,
  bootable = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// Default preview: a 1200×630 capture of the desktop in public/og.png.
const ogImage = new URL(image ?? `${import.meta.env.BASE_URL}og.png`, Astro.site).toString();
const ogImageAlt = "The RETRO//OS desktop: pixel icons over a synthwave sunset and neon grid.";
---

<!doctype html>
<!-- The defaults; the bootstrap script swaps in stored settings before first paint. -->
<html lang="en" {...rootAttributes(DEFAULT_SETTINGS)} data-bootable={bootable ? "" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline set:html={SETTINGS_BOOTSTRAP_SCRIPT} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#2a1a4a" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-chrome" preload />
    <Font cssVariable="--font-mono" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="RETRO//OS" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="RETRO//OS writing"
      href={`${import.meta.env.BASE_URL}rss.xml`}
    />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body data-document={document ? "" : undefined}>
    <slot />
  </body>
</html>
