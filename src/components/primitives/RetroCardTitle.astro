---
/**
 * RetroCardTitle — optional card title bar with a named right slot.
 */

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props as Props;
const titleClass = [
  "flex items-center justify-between border-b border-bevel-shadow px-3 py-1.5 font-chrome text-15",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={titleClass}>
  <span><slot /></span>
  <slot name="right" />
</div>
