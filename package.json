{
  "name": "retro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Retro — a retro-OS portfolio. Astro + TypeScript + Tailwind v4.",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:md",
    "lint:js": "eslint . --cache --cache-location=.cache/eslint --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\" --cache --cache-location=.cache/stylelint",
    "lint:md": "markdownlint-cli2 \"**/*.{md,mdx}\" \"#node_modules\" \"#dist\" \"#.astro\" \"#retro-os\" \"#.claude\" \"#.github\" \"#.direnv\"",
    "fix": "eslint . --cache --cache-location=.cache/eslint --fix && stylelint \"src/**/*.css\" --cache --cache-location=.cache/stylelint --fix && prettier --write --cache --cache-location=.cache/prettier .",
    "format": "prettier --write --cache --cache-location=.cache/prettier .",
    "format:check": "prettier --check --cache --cache-location=.cache/prettier .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "ci": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepare": "lefthook install || true",
    "clean": "rm -rf dist .astro node_modules/.vite node_modules/.vitest node_modules/.cache coverage playwright-report .cache"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.1",
    "@astrojs/react": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.10.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-astro": "^1.3.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "happy-dom": "^15.11.0",
    "knip": "^5.40.0",
    "lefthook": "^1.10.0",
    "markdownlint-cli2": "^0.16.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  }
}
